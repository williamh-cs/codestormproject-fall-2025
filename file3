:root {
    --bg: antiquewhite;
    --text: #222;
    --accent: #6b5b95;
    --muted: #555;
}

[data-theme="dark"] {
    --bg: #121212;
    --text: #e8e8e8;
    --accent: #8ab4f8;
    --muted: #bdbdbd;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
    margin: 0;
    padding: 0;
    font-family: Inter, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
}

.site-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

h1 { font-size: 1.8rem; margin: 0; }

button#themeToggle {
    background: transparent;
    border: 1px solid var(--muted);
    color: var(--text);
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
}

main { width: 100%; background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 8px; }

footer { width: 100%; text-align: center; color: var(--muted); }

@media (max-width: 520px) {
    .container { padding: 1rem; }
    h1 { font-size: 1.3rem; }
}

/* Chat UI styles */
.chat-window{
    width:100%;
    max-width:900px;
    display:flex;
    flex-direction:column;
    gap:0.75rem;
}
.messages{
    list-style: none;
    margin: 0;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 50vh;
    overflow: auto;
    background: linear-gradient(180deg, rgba(0,0,0,0.02), transparent);
    border-radius: 8px;
}

.message { max-width: 85%; display: flex; flex-direction: column; }
.message .meta { font-size: 0.7rem; color: var(--muted); margin-bottom: 0.2rem; }
.message.user { align-self: flex-end; text-align: right; }
.message.bot { align-self: flex-start; text-align: left; }

.bubble { padding: 0.6rem 0.8rem; border-radius: 10px; background: rgba(255,255,255,0.06); color: var(--text); }
.message.user .bubble { background: var(--accent); color: white; }

.chat-form { display: flex; gap: 0.5rem; margin: 0; }
.chat-form input[type="text"] { flex: 1; padding: 0.6rem 0.75rem; border: 1px solid #ccc; border-radius: 8px; }
.chat-form button { padding: 0.55rem 0.75rem; border-radius: 8px; border: none; background: var(--accent); color: #fff; cursor: pointer; }

.visually-hidden { position: absolute !important; height: 1px; width: 1px; overflow: hidden; clip: rect(1px,1px,1px,1px); white-space: nowrap; }

@media (max-width: 420px) {
    .bubble { font-size: 0.95rem; }
}
